# Application Settings
PROJECT_NAME=Trip Me Buddy API
VERSION=1.0.0
DEBUG=False

# Database Configuration
DB_HOST=your-rds-endpoint.amazonaws.com
DB_PORT=5432
DB_NAME=tripmebbuddy_v2
DB_USER=your-db-username
DB_PASSWORD=your-db-password

# Redis Configuration
REDIS_HOST=your-redis-endpoint.amazonaws.com
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Keycloak Configuration
KEYCLOAK_SERVER_URL=http://your-alb-dns-name
KEYCLOAK_REALM=tripmebbuddy
KEYCLOAK_CLIENT_ID=trip-me-buddy-backend
KEYCLOAK_CLIENT_SECRET=your-client-secret

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# JWT Settings
ALGORITHM=RS256
